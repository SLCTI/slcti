<%- include('header', { title: t('Expenses') }) %>
<% const money = value => value != null ? value.toFixed(2) + ' $' : ''; %>
            <div class="toolbar">
                <h1><%= t('Expenses') %></h1>
            </div>

            <%# The filter fields live in the table and are tied to this form by their form attribute %>
            <form method="get" action="/secure/expenses" id="filters" data-auto-submit></form>

            <div class="table-wrap">
                <table class="sortable" data-sort-title="<%= t('Sort') %>">
                    <thead>
                        <tr><th class="num"><%= t('Week') %></th><th><%= t('Date') %></th><th><%= t('Day') %></th><th><%= t('Client') %></th><th class="num"><%= t('Units') %></th><th class="num"><%= t('Rate') %></th><th class="num"><%= t('Subtotal') %></th><th class="num"><%= t('GST (5 %)') %></th><th class="num"><%= t('QST (9.975 %)') %></th><th class="num"><%= t('Total') %></th><th><%= t('Description') %></th><th></th></tr>
                        <tr class="filter-row">
                            <td></td>
                            <td>
                                <select name="month" form="filters" aria-label="<%= t('Month') %>" title="<%= t('Month') %>">
                                    <option value=""><%= t('All') %></option>
                                    <% months.forEach(month => { %>
                                        <option value="<%= month %>" <%= month === filters.month ? 'selected' : '' %>><%= month %></option>
                                    <% }); %>
                                </select>
                            </td>
                            <td></td>
                            <td>
                                <select name="customer" form="filters" aria-label="<%= t('Client') %>">
                                    <option value=""><%= t('All') %></option>
                                    <% customers.forEach(customer => { %>
                                        <option value="<%= customer.id %>" <%= String(customer.id) === String(filters.customer) ? 'selected' : '' %>><%= customer.name %></option>
                                    <% }); %>
                                </select>
                            </td>
                            <td colspan="7"></td>
                            <td class="actions">
                                <a href="/secure/expenses?customer=&month=" class="button small secondary" title="<%= t('Clear filters') %>" aria-label="<%= t('Clear filters') %>"><%- include('icon', { name: 'clear' }) %></a>
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (rows.length === 0) { %>
                            <tr><td colspan="12" class="empty"><%= t('No expenses for this period.') %></td></tr>
                        <% } %>
                        <% rows.forEach(row => { %>
                            <tr>
                                <% const date = (row.start || '').slice(0, 10); %>
                                <td class="num"><%= date ? weekOfYear(date) : '' %></td>
                                <td class="nowrap"><%= date %></td>
                                <td><%= date ? dayOfWeek(date) : '' %></td>
                                <td><%= row.customer_name %></td>
                                <td class="num"><%= row.unit %></td>
                                <td class="num"><%= money(row.rate) %></td>
                                <td class="num"><%= money(row.subtotal) %></td>
                                <td class="num"><%= row.gst ? money(row.gst_amount) : '' %></td>
                                <td class="num"><%= row.qst ? money(row.qst_amount) : '' %></td>
                                <td class="num"><%= money(row.total) %></td>
                                <td class="description"><%= row.description %></td>
                                <td class="actions">
                                    <% if (isAdmin) { %>
                                    <a href="/secure/expenses/<%= row.id %>/edit" class="button small" title="<%= t('Edit') %>" aria-label="<%= t('Edit') %>"><%- include('icon', { name: 'edit' }) %></a>
                                    <form method="post" action="/secure/expenses/<%= row.id %>/delete" class="inline" data-confirm="<%= t('Delete this expense?') %>">
                                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                                        <button type="submit" class="small delete" title="<%= t('Delete') %>" aria-label="<%= t('Delete') %>"><%- include('icon', { name: 'delete' }) %></button>
                                    </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                    <tfoot>
                        <tr class="total-row">
                            <td class="nowrap" colspan="3"><%= rows.length %> <%= rows.length === 1 ? t('record') : t('records') %></td>
                            <td colspan="3"></td>
                            <td class="num"><%= money(totals.subtotal) %></td>
                            <td class="num"><%= money(totals.gst) %></td>
                            <td class="num"><%= money(totals.qst) %></td>
                            <td class="num"><%= money(totals.total) %></td>
                            <td></td>
                            <td class="actions">
                                <% if (isAdmin) { %>
                                <a href="/secure/expenses/new" class="button small" title="<%= t('New') %>" aria-label="<%= t('New') %>"><%- include('icon', { name: 'add' }) %></a>
                                <% } %>
                                <a href="/secure/expenses.csv?<%= query %>" class="button small secondary" title="<%= t('Export CSV') %>" aria-label="<%= t('Export CSV') %>"><%- include('icon', { name: 'download' }) %></a>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
<%- include('footer') %>
