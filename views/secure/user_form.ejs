<%- include('header', { title: user.id ? t('Edit user') : t('New user') }) %>
            <form method="post" action="/secure/users<%= user.id ? '/' + user.id : '' %>" class="card">
                <h1><%= user.id ? t('Edit user') : t('New user') %></h1>
                <% errors.forEach(error => { %><p class="error"><%= t(error) %></p><% }); %>
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <label><%= t('First name') %>
                    <input name="first_name" value="<%= user.first_name %>">
                </label>
                <label><%= t('Last name') %>
                    <input name="last_name" value="<%= user.last_name %>">
                </label>
                <label><%= t('Title') %>
                    <input name="title" value="<%= user.title %>">
                </label>
                <%# The email is the login; never autofilled, or the browser would put the signed-in administrator's own login and password here %>
                <label><%= t('Email') %>
                    <input type="email" name="email" value="<%= user.email %>" autocomplete="off">
                </label>
                <label><%= t('Telephone') %>
                    <input type="tel" name="telephone" value="<%= user.telephone %>">
                </label>
                <label><%= user.has_password ? t('New password') : t('Password') %>
                    <input type="password" name="password" minlength="12" autocomplete="new-password">
                </label>
                <label><%= t('Confirm password') %>
                    <input type="password" name="password_confirm" minlength="12" autocomplete="new-password">
                </label>
                <label><%= t('Role') %>
                    <select name="role">
                        <option value=""><%= t('No access') %></option>
                        <option value="accountant" <%= user.role === 'accountant' ? 'selected' : '' %>><%= t('Accountant (read-only)') %></option>
                        <option value="client" <%= user.role === 'client' ? 'selected' : '' %>><%= t('Client (own data)') %></option>
                        <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>><%= t('Administrator') %></option>
                    </select>
                </label>
                <label><%= t('Organisation') %>
                    <select name="resource_id">
                        <option value=""></option>
                        <% organisations.forEach(organisation => { %>
                            <option value="<%= organisation.id %>" <%= organisation.id === user.resource_id ? 'selected' : '' %>><%= organisation.name %></option>
                        <% }); %>
                    </select>
                </label>
                <div class="form-actions">
                    <a href="/secure/users" class="button secondary" title="<%= t('Cancel') %>" aria-label="<%= t('Cancel') %>"><%- include('icon', { name: 'clear' }) %></a>
                    <button type="submit" title="<%= t('Save') %>" aria-label="<%= t('Save') %>"><%- include('icon', { name: 'save' }) %></button>
                </div>
            </form>
<%- include('footer') %>
