<%- include('header', { title: resource.id ? t('Edit organisation') : t('New organisation') }) %>
            <form method="post" action="/secure/resources<%= resource.id ? '/' + resource.id : '' %>" class="card">
                <h1><%= resource.id ? t('Edit organisation') : t('New organisation') %></h1>
                <% errors.forEach(error => { %><p class="error"><%= t(error) %></p><% }); %>
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <label><%= t('Code') %>
                    <input name="code" value="<%= resource.code %>" required>
                </label>
                <label><%= t('Organisation') %>
                    <input name="organisation" value="<%= resource.organisation %>">
                </label>
                <label><%= t('Website') %>
                    <input type="url" name="website" value="<%= resource.website %>">
                </label>
                <label><%= t('Address') %>
                    <textarea name="address" rows="2"><%= resource.address %></textarea>
                </label>
                <label><%= t('NEQ') %>
                    <input name="neq" value="<%= resource.neq %>">
                </label>
                <label><%= t('GST Number') %>
                    <input name="gst_number" value="<%= resource.gst_number %>">
                </label>
                <label><%= t('QST Number') %>
                    <input name="qst_number" value="<%= resource.qst_number %>">
                </label>
                <label><%= t('Bank Account') %>
                    <input name="bank_account" value="<%= resource.bank_account %>">
                </label>
                <div class="form-actions">
                    <a href="/secure/resources" class="button secondary" title="<%= t('Cancel') %>" aria-label="<%= t('Cancel') %>"><%- include('icon', { name: 'clear' }) %></a>
                    <button type="submit" title="<%= t('Save') %>" aria-label="<%= t('Save') %>"><%- include('icon', { name: 'save' }) %></button>
                </div>
            </form>
<%- include('footer') %>
