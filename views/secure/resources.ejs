<%- include('header', { title: t('Organisations') }) %>
            <div class="toolbar">
                <h1><%= t('Organisations') %></h1>
            </div>

            <% if (error) { %><p class="error"><%= t(error) %></p><% } %>

            <% if (resources.length === 0) { %>
                <p class="empty"><%= t('No organisations yet.') %> <a href="/secure/resources/new" class="button small" title="<%= t('New organisation') %>" aria-label="<%= t('New organisation') %>"><%- include('icon', { name: 'add' }) %></a></p>
            <% } else { %>
                <div class="table-wrap">
                    <table class="sortable" data-sort-title="<%= t('Sort') %>">
                        <thead>
                            <tr class="calc"><th><%= t('Code') %></th><th><%= t('Organisation') %></th><th><%= t('Website') %></th><th></th></tr>
                        </thead>
                        <tbody>
                            <% resources.forEach(resource => { %>
                                <tr>
                                    <td class="nowrap"><%= resource.code %></td>
                                    <td><%= resource.organisation %></td>
                                    <td><% if (/^https?:\/\//i.test(resource.website || '')) { %><a href="<%= resource.website %>" target="_blank" rel="noopener noreferrer"><%= resource.website %></a><% } else { %><%= resource.website %><% } %></td>
                                    <td class="actions calc">
                                        <a href="/secure/resources/<%= resource.id %>/edit" class="button small" title="<%= t('Edit') %>" aria-label="<%= t('Edit') %>"><%- include('icon', { name: 'edit' }) %></a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                        <tfoot>
                            <tr class="total-row calc">
                                <td colspan="3"><%= resources.length %> <%= resources.length === 1 ? t('organisation') : t('organisations') %></td>
                                <td class="actions calc">
                                    <a href="/secure/resources/new" class="button small" title="<%= t('New organisation') %>" aria-label="<%= t('New organisation') %>"><%- include('icon', { name: 'add' }) %></a>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            <% } %>
<%- include('footer') %>
