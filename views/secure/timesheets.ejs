<%- include('header', { title: t('Timesheets') }) %>
            <div class="toolbar">
                <h1><%= t('Timesheets') %></h1>
            </div>

            <%# The filter fields live in the table and are tied to this form by their form attribute %>
            <form method="get" action="/secure/timesheets" id="filters" data-auto-submit></form>

            <div class="table-wrap">
                <table class="sortable" data-sort-title="<%= t('Sort') %>">
                    <thead>
                        <tr><th class="num"><%= t('Week') %></th><th><%= t('Date') %></th><th><%= t('Day') %></th><th><%= t('Time') %></th><th><%= t('Client') %></th><th class="num"><%= t('Hours') %></th><th class="num"><%= t('Rate') %></th><% if (isAdmin) { %><th><%= t('Description') %></th><% } %><th></th></tr>
                        <tr class="filter-row">
                            <td></td>
                            <td>
                                <input type="date" name="from" value="<%= filters.from %>" form="filters" aria-label="<%= t('From') %>" title="<%= t('From') %>">
                                <input type="date" name="to" value="<%= filters.to %>" form="filters" aria-label="<%= t('To') %>" title="<%= t('To') %>">
                            </td>
                            <td></td>
                            <td></td>
                            <td>
                                <select name="customer" form="filters" aria-label="<%= t('Client') %>">
                                    <option value=""><%= t('All') %></option>
                                    <% customers.forEach(customer => { %>
                                        <option value="<%= customer.id %>" <%= String(customer.id) === String(filters.customer) ? 'selected' : '' %>><%= customer.name %></option>
                                    <% }); %>
                                </select>
                            </td>
                            <td></td>
                            <td></td>
                            <% if (isAdmin) { %><td></td><% } %>
                            <td class="actions">
                                <a href="/secure/timesheets?customer=&from=&to=" class="button small secondary" title="<%= t('Clear filters') %>" aria-label="<%= t('Clear filters') %>"><%- include('icon', { name: 'clear' }) %></a>
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (rows.length === 0) { %>
                            <tr><td colspan="<%= isAdmin ? 9 : 8 %>" class="empty"><%= t('No entries for this period.') %></td></tr>
                        <% } %>
                        <% rows.forEach(row => { %>
                            <tr>
                                <% const date = (row.start || '').slice(0, 10); %>
                                <td class="num"><%= date ? weekOfYear(date) : '' %></td>
                                <td class="nowrap"><%= date %></td>
                                <td><%= date ? dayOfWeek(date) : '' %></td>
                                <td class="nowrap"><%= (row.start || '').slice(11, 16) %> – <%= (row.end || '').slice(11, 16) %></td>
                                <td><%= row.customer_name %></td>
                                <td class="num"><%= row.hours != null ? row.hours.toFixed(2) : '' %></td>
                                <td class="num"><%= row.rate != null ? row.rate.toFixed(2) + ' $' : '' %></td>
                                <% if (isAdmin) { %>
                                <td class="description"><%= row.description %></td>
                                <td class="actions">
                                    <a href="/secure/timesheets/<%= row.id %>/edit" class="button small" title="<%= t('Edit') %>" aria-label="<%= t('Edit') %>"><%- include('icon', { name: 'edit' }) %></a>
                                    <form method="post" action="/secure/timesheets/<%= row.id %>/delete" class="inline" data-confirm="<%= t('Delete this entry?') %>">
                                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                                        <button type="submit" class="small delete" title="<%= t('Delete') %>" aria-label="<%= t('Delete') %>"><%- include('icon', { name: 'delete' }) %></button>
                                    </form>
                                </td>
                                <% } else { %>
                                <td></td>
                                <% } %>
                            </tr>
                        <% }); %>
                    </tbody>
                    <tfoot>
                        <tr class="total-row">
                            <td class="nowrap" colspan="3"><%= rows.length %> <%= rows.length === 1 ? t('record') : t('records') %></td>
                            <td></td>
                            <td></td>
                            <td class="num"><%= totals.hours.toFixed(2) %></td>
                            <td class="num"><%= totals.amount.toFixed(2) %> $</td>
                            <% if (isAdmin) { %><td></td><% } %>
                            <td class="actions">
                                <% if (isAdmin) { %>
                                <a href="/secure/timesheets/new" class="button small" title="<%= t('New') %>" aria-label="<%= t('New') %>"><%- include('icon', { name: 'add' }) %></a>
                                <% } %>
                                <a href="/secure/timesheets.csv?<%= query %>" class="button small secondary" title="<%= t('Export CSV') %>" aria-label="<%= t('Export CSV') %>"><%- include('icon', { name: 'download' }) %></a>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
<%- include('footer') %>
