<%- include('header', { title: t('Change password') }) %>
            <form method="post" action="/secure/password" class="card">
                <h1><%= t('Change password') %></h1>
                <% if (saved) { %><p class="saved"><%= t('Your password has been changed.') %></p><% } %>
                <% errors.forEach(error => { %><p class="error"><%= t(error) %></p><% }); %>
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <%# For password managers: the account whose password changes %>
                <input type="email" name="username" value="<%= session.username %>" autocomplete="username" hidden>
                <label><%= t('Current password') %>
                    <input type="password" name="current_password" autocomplete="current-password" required autofocus>
                </label>
                <label><%= t('New password') %>
                    <input type="password" name="password" minlength="12" autocomplete="new-password" required>
                </label>
                <label><%= t('Confirm password') %>
                    <input type="password" name="password_confirm" minlength="12" autocomplete="new-password" required>
                </label>
                <div class="form-actions">
                    <a href="/secure" class="button secondary" title="<%= t('Cancel') %>" aria-label="<%= t('Cancel') %>"><%- include('icon', { name: 'clear' }) %></a>
                    <button type="submit" title="<%= t('Save') %>" aria-label="<%= t('Save') %>"><%- include('icon', { name: 'save' }) %></button>
                </div>
            </form>
<%- include('footer') %>
