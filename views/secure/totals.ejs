<%- include('header', { title: t('Totals') }) %>
<%
    const money = value => value.toFixed(2) + ' $';
    // Payment minus total: positive when overpaid, negative when an amount is still owed
    const difference = (paid, total) => Math.round((paid - total) * 100) / 100;
    const sign = value => value > 0 ? 'positive' : value < 0 ? 'negative' : '';
    // The payment forms come back to this page with its filters
    const back = encodeURIComponent(query);
%>
            <div class="toolbar">
                <h1><%= t('Totals') %></h1>
            </div>

            <%# The filter fields live in the table and are tied to this form by their form attribute %>
            <form method="get" action="/secure/totals" id="filters" data-auto-submit></form>

            <div class="table-wrap">
                <table class="sortable" data-sort-title="<%= t('Sort') %>">
                    <thead>
                        <tr class="calc"><th class="num calc"><%= t('Invoice') %></th><th class="calc"><%= t('Month') %></th><th><%= t('Client') %></th><th><%= t('Payer') %></th><th><%= t('Date') %></th><th class="num"><%= t('Payment') %></th><th class="num calc"><%= t('Subtotal') %></th><th class="num calc"><%= t('GST (5 %)') %></th><th class="num calc"><%= t('QST (9.975 %)') %></th><th class="num calc"><%= t('Total') %></th><th class="num calc"><%= t('Difference') %></th><th></th></tr>
                        <tr class="filter-row calc">
                            <td class="calc"></td>
                            <td class="calc">
                                <select name="month" form="filters" aria-label="<%= t('Month') %>" title="<%= t('Month') %>">
                                    <option value=""><%= t('All') %></option>
                                    <% months.forEach(month => { %>
                                        <option value="<%= month %>" <%= month === filters.month ? 'selected' : '' %>><%= month %></option>
                                    <% }); %>
                                </select>
                            </td>
                            <td>
                                <select name="customer" form="filters" aria-label="<%= t('Client') %>">
                                    <option value=""><%= t('All') %></option>
                                    <% customers.forEach(customer => { %>
                                        <option value="<%= customer.id %>" <%= String(customer.id) === String(filters.customer) ? 'selected' : '' %>><%= customer.name %></option>
                                    <% }); %>
                                </select>
                            </td>
                            <td>
                                <select name="payer" form="filters" aria-label="<%= t('Payer') %>">
                                    <option value=""><%= t('All') %></option>
                                    <% payers.forEach(payer => { %>
                                        <option value="<%= payer.id %>" <%= String(payer.id) === String(filters.payer) ? 'selected' : '' %>><%= payer.name %></option>
                                    <% }); %>
                                </select>
                            </td>
                            <td></td>
                            <td></td>
                            <td class="calc"></td>
                            <td class="calc"></td>
                            <td class="calc"></td>
                            <td class="calc"></td>
                            <td class="calc"></td>
                            <td class="actions">
                                <a href="/secure/totals?customer=&payer=&month=" class="button small secondary" title="<%= t('Clear filters') %>" aria-label="<%= t('Clear filters') %>"><%- include('icon', { name: 'clear' }) %></a>
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (invoices.length === 0) { %>
                            <tr><td colspan="12" class="empty"><%= t('No invoices yet.') %></td></tr>
                        <% } %>
                        <% invoices.forEach(invoice => { %>
                            <tr>
                                <td class="num calc"><%= String(invoice.number).padStart(3, '0') %></td>
                                <td class="nowrap calc"><%= invoice.month %></td>
                                <td><%= invoice.customer_name %></td>
                                <td><%= invoice.payer_name %></td>
                                <td class="nowrap"><%= invoice.paid_dates.join(', ') %></td>
                                <td class="num"><%= invoice.paid ? money(invoice.paid) : '' %></td>
                                <td class="num calc"><%= money(invoice.subtotal) %></td>
                                <td class="num calc"><%= money(invoice.gst) %></td>
                                <td class="num calc"><%= money(invoice.qst) %></td>
                                <td class="num calc"><%= money(invoice.total) %></td>
                                <% const diff = difference(invoice.paid, invoice.total); %>
                                <td class="num calc <%= sign(diff) %>"><%= diff ? money(diff) : '' %></td>
                                <%# One line per payment matched to the invoice, e.g. a payment of two invoices is on both %>
                                <td class="actions calc">
                                    <% if (isAdmin) { invoice.payments.forEach(payment => { const label = `${payment.date}, ${money(payment.amount)}`; %>
                                    <div class="actions">
                                        <a href="/secure/payments/<%= payment.id %>/edit?back=<%= back %>" class="button small" title="<%= t('Edit payment') %> (<%= label %>)" aria-label="<%= t('Edit payment') %> (<%= label %>)"><%- include('icon', { name: 'edit' }) %></a>
                                        <form method="post" action="/secure/payments/<%= payment.id %>/delete" class="inline" data-confirm="<%= t('Delete this payment?') %> (<%= label %>)">
                                            <input type="hidden" name="_csrf" value="<%= csrf %>">
                                            <input type="hidden" name="back" value="<%= query %>">
                                            <button type="submit" class="small delete" title="<%= t('Delete') %> (<%= label %>)" aria-label="<%= t('Delete') %> (<%= label %>)"><%- include('icon', { name: 'delete' }) %></button>
                                        </form>
                                    </div>
                                    <% }); } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                    <tfoot>
                        <tr class="total-row calc">
                            <td colspan="5"><%= invoices.length %> <%= invoices.length === 1 ? t('invoice') : t('invoices') %></td>
                            <td class="num"><%= money(paid) %></td>
                            <td class="num calc"><%= money(subtotal) %></td>
                            <td class="num calc"><%= money(gst) %></td>
                            <td class="num calc"><%= money(qst) %></td>
                            <td class="num calc"><%= money(total) %></td>
                            <td class="num calc <%= sign(difference(paid, total)) %>"><%= money(difference(paid, total)) %></td>
                            <td class="actions">
                                <% if (isAdmin) { %>
                                <a href="/secure/payments/new?customer=<%= filters.customer %>&amp;payer=<%= filters.payer %>&amp;back=<%= back %>" class="button small" title="<%= t('New payment') %>" aria-label="<%= t('New payment') %>"><%- include('icon', { name: 'add' }) %></a>
                                <% } %>
                                <a href="/secure/totals.csv?<%= query %>" class="button small secondary" title="<%= t('Export CSV') %>" aria-label="<%= t('Export CSV') %>"><%- include('icon', { name: 'download' }) %></a>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
<%- include('footer') %>
