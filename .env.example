# Copy to .env (development) or .env.production (sent as .env to the server by bin/deploy.ps1); neither is ever committed

# development or production (production serves HTTPS with the certificates below and hides error details)
NODE_ENV=development

# Folder holding slcti_ca.crt, slcti_ca.ca-bundle and slcti_ca.key (production only; ~ is the home folder)
SLCTI_CERTIFICATES=

# Optional: location of the encrypted database (default: private/slcti.db)
SLCTI_DATABASE=

# Key of the encrypted database: without it the data cannot be read, keep a copy in a password manager
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SLCTI_DB_KEY=
