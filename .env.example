# Copy to .env (development) or .env.production (production, sent as .env to the server by bin/deploy.ps1)
# Never committed; .env, .env.production and .env.example list the same variables

# -------- Site --------
# development or production (production serves HTTPS with the certificates below and hides error details)
NODE_ENV=development
# Port of the site (default: 3000)
PORT=
# Folder of slcti_ca.crt, slcti_ca.ca-bundle and slcti_ca.key, production only (~ is the home folder)
SLCTI_CERTIFICATES=

# -------- Database --------
# Location of the encrypted database (default: private/slcti.db)
SLCTI_DATABASE=
# Key of the encrypted database, the same in .env and .env.production: without it the data cannot be read, keep a copy in a password manager
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SLCTI_DATABASE_KEY=

# -------- Deployment (read from .env by bin/deploy.ps1, on the development machine) --------
# SSH user and host of the server (SSH only answers on the local network, not through www.slcti.ca), folder of the site from the home folder, and service
SLCTI_DEPLOY_USER=
SLCTI_DEPLOY_HOST=
SLCTI_DEPLOY_DIR=source/resume
SLCTI_DEPLOY_SERVICE=resume.service
# Git repository of the code: the local push and the server fetch both go to it
SLCTI_DEPLOY_REPOSITORY=https://github.com/SLCTI/slcti.git
